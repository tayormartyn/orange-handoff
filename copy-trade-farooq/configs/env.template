# ============================================================================
# Signal Terminal — cTrader Open API (READ-ONLY DEMO) credentials — TEMPLATE
# Sanitized for handoff: every secret value has been stripped.
# ============================================================================

# ---- REQUIRED (the OAuth app credentials; both are sensitive) ----
CTRADER_CLIENT_ID=        # set in Windows Credential Manager / DPAPI
CTRADER_CLIENT_SECRET=    # set in Windows Credential Manager / DPAPI

# ---- OAuth tokens (SECRET) ----
# Normally left blank: the browser authorise flow (python ctrader_auth.py url ->
# token <CODE>) mints these and caches them in data/ctrader_token.json (gitignored).
CTRADER_ACCESS_TOKEN=     # set in Windows Credential Manager / DPAPI
CTRADER_REFRESH_TOKEN=    # set in Windows Credential Manager / DPAPI

# ---- API account selector (optional) ----
CTRADER_ACCOUNT_ID=

# ---- safety defaults (pre-filled; do not change) ----
CTRADER_ENV=demo
CTRADER_SCOPE=view

# ---- code-enforced lock (informational only — NOT read from this file) ----
# Read-only is hard-coded: CTRADER_EXECUTION_ENABLED=False is a constant in
# ctrader_config.py and broker_readonly/config.py.
CTRADER_EXECUTION_ENABLED=False

# ---- optional overrides ----
CTRADER_REDIRECT_URI=http://localhost/
CTRADER_GOLD_SYMBOL=XAUUSD

# ---- Telegram listener credentials (NOT stored in any file) ----
# TELEGRAM_API_ID / TELEGRAM_API_HASH are User-scope Windows environment variables.
TELEGRAM_API_ID=          # set in Windows Credential Manager / DPAPI
TELEGRAM_API_HASH=        # set in Windows Credential Manager / DPAPI
# The Telegram auth session file (whale_room.session) is EXCLUDED from this
# handoff on purpose — it is account-sensitive and must be re-created by the
# receiving operator with their own authorised session.
