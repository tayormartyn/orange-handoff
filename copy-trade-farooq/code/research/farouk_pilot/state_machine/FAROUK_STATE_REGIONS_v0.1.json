{
  "rule_version": "v0.1",
  "architecture": "HIERARCHICAL + ORTHOGONAL. Regions 1-4 run CONCURRENTLY as context/market regions (one active state each, updated by events). Regions 5-6 are PER-SETUP-INSTANCE lifecycles (many instances may coexist, each with immutable origin). Region 7 is REFERENCE-ONLY and lives OUTSIDE the Alpha detector. This avoids a single flat enum.",
  "regions": {
    "1_SESSION_CONTEXT": {
      "kind": "concurrent_context",
      "states": [
        "OUTSIDE_SESSION",
        "SESSION_RANGE_FORMING",
        "SESSION_RANGE_LOCKED",
        "SESSION_ACTIVE",
        "SESSION_CLOSED"
      ],
      "initial": "OUTSIDE_SESSION",
      "owner_evidence": "[kyle] v2 Market-Session boxes + [kyle] v1 ORB session windows"
    },
    "2_VALUE_LOCATION": {
      "kind": "concurrent_context",
      "states": [
        "VALUE_UNKNOWN",
        "ABOVE_VALUE",
        "INSIDE_VALUE",
        "BELOW_VALUE",
        "AT_POC",
        "AT_VAH",
        "AT_VAL",
        "VWAP_ALIGNED",
        "VWAP_OPPOSED"
      ],
      "initial": "VALUE_UNKNOWN",
      "owner_evidence": "[kyle] v1 POC/VAH/VAL + [kyle] v2 multi-timeframe VWAP",
      "note": "VWAP_ALIGNED/VWAP_OPPOSED are a nested VWAP sub-axis; price-vs-value (ABOVE/INSIDE/BELOW/AT_*) is the primary axis."
    },
    "3_LIQUIDITY_EVENT": {
      "kind": "concurrent_context",
      "states": [
        "NO_LIQUIDITY_EVENT",
        "LIQUIDITY_APPROACH",
        "SWEEP_CANDIDATE",
        "SWEEP_CONFIRMED",
        "SFP_CANDIDATE",
        "SFP_CONFIRMED",
        "SWEEP_INVALIDATED"
      ],
      "initial": "NO_LIQUIDITY_EVENT",
      "owner_evidence": "[kyle] v1 SFP + liquidity sweeps"
    },
    "4_ORB_EVENT": {
      "kind": "concurrent_context",
      "states": [
        "ORB_NOT_ACTIVE",
        "ORB_FORMING",
        "ORB_LOCKED",
        "BREAKOUT_UNCONFIRMED",
        "BREAKOUT_CONFIRMED",
        "FAILED_BREAKOUT",
        "ORB_EXPIRED"
      ],
