        "VETOED",
        "EXPIRED",
        "BIAS_CHANGED"
      ],
      "initial": "NOT_ELIGIBLE",
      "terminal_alpha_state": "QUALIFIED_CANDIDATE",
      "note": "QUALIFIED_CANDIDATE is the LAST state the Alpha detector may reach. It emits an observation only."
    },
    "7_CAMPAIGN_LIFECYCLE_REFERENCE_ONLY": {
      "kind": "reference_only_OUTSIDE_detector",
      "states": [
