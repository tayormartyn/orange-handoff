//@version=6
// ORANGE_XAUUSD_1M_BAR_FEED — minimal completed-bar JSON emitter (observation-only).
//
// SAFETY: this is an INDICATOR. It contains NO strategy.*, NO order, NO entry/exit,
// NO execution code of any kind. Its ONLY function is to emit one JSON message per
// CONFIRMED 1-minute bar via alert() so the existing logging-only webhook receiver
// can store it. It draws nothing on the chart.
//
// Emission guarantees:
//   * alert.freq_once_per_bar_close => fires exactly ONCE per bar, only when the bar
//     CLOSES (confirmed bars only; never intra-bar; safe across TradingView reconnects —
//     a reconnect can at worst re-deliver a bar, and the receiver's predictable key makes
//     re-delivery idempotent).
//   * dedup_id = "<symbol>/<bar open time in ms>" — stable across retries.
//   * timestamps are exact UTC ISO-8601 from TradingView's bar clock.
indicator("ORANGE_XAUUSD_1M_BAR_FEED", overlay = true)

plot(na)   // indicator requires one output; nothing is drawn

barJson() =>
    '{"schema_version":"tv_bar_v1"'
      + ',"event_type":"XAU_1M_BAR"'
      + ',"instrument":"XAUUSD"'
      + ',"symbol":"' + syminfo.tickerid + '"'
      + ',"interval":"' + timeframe.period + '"'
      + ',"bar_open_time":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"'
      + ',"bar_close_time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"'
      + ',"open":' + str.tostring(open)
      + ',"high":' + str.tostring(high)
      + ',"low":' + str.tostring(low)
      + ',"close":' + str.tostring(close)
      + ',"volume":' + str.tostring(volume)
      + ',"source":"ORANGE_XAUUSD_1M_BAR_FEED_v1"'
      + ',"dedup_id":"' + syminfo.tickerid + '/' + str.tostring(time) + '"}'

alert(barJson(), alert.freq_once_per_bar_close)
